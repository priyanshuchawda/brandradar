# Copy to .env.local. Never commit real keys.

BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=

COLLECTOR_ECOMMERCE_DISCOVERY=
COLLECTOR_ECOMMERCE_PDP=
COLLECTOR_EDTECH_DISCOVERY=
COLLECTOR_EDTECH_PDP=
COLLECTOR_FOOD_DISCOVERY=
COLLECTOR_FOOD_PDP=

# Monday Diff — Discovery-style collector for rival blog/guides/changelog pages.
COLLECTOR_INTEL_UPDATES=

# Heal Lab — scraper for /heal-lab/before (own demo site). Create after deploy.
# COLLECTOR_HEAL_LAB=

# Flash-Lite: rival pick + play copy. Flash: URL context, extract, heal prompts.
# Monday Diff plays are deterministic — Gemini is not on the weekly hot path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FLASH=gemini-3.6-flash

# false = try Scraper Studio collectors first when ids are set.
USE_MOCK=true

# Optional Monday cron auth for /api/cron/monday-diff
# CRON_SECRET=
# Set false to skip auto-heal on broken Monday cron pulls (default: heal when broken).
# INTEL_AUTO_HEAL_ON_CRON=false

# Vercel Blob — required on Vercel for week-over-week intel snapshots (Monday Diff memory).
# BLOB_READ_WRITE_TOKEN=

# Rival homepage discovery (fast mode, 5 results, no page body, 6h cache).
USE_DISCOVER=true

# Optional production controls. See docs/security.md.
# BRANDRADAR_API_KEY=
# ALLOW_DEMO_FIXTURE=false

# Monday Diff → Discord (see docs/discord.md)
# DISCORD_WEBHOOK_URL=
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=
# DISCORD_GUILD_ID=
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_ID=
# DISCORD_PUBLIC_KEY=
