# Copy to .env.local. Never commit real keys.

# ── Bright Data (Scraper Studio + SDK) ─────────────────────────────
BRIGHT_DATA_API_TOKEN=
BRIGHTDATA_API_KEY=              # same value as above — required for CLI (bdata)

COLLECTOR_ECOMMERCE_DISCOVERY=
COLLECTOR_ECOMMERCE_PDP=
COLLECTOR_EDTECH_DISCOVERY=
COLLECTOR_EDTECH_PDP=
COLLECTOR_FOOD_DISCOVERY=
COLLECTOR_FOOD_PDP=

# Monday Diff — rival guides/blogs/changelogs (listing rows)
COLLECTOR_INTEL_UPDATES=

# Heal Lab — /heal-lab/before demo page
COLLECTOR_HEAL_LAB=

# false = try Studio collectors when ids are set
USE_MOCK=true

# ── Gemini (optional) ──────────────────────────────────────────────
# Monday Diff plays are deterministic — Gemini not on weekly hot path
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_FLASH=gemini-3.6-flash

# ── Cron / production ──────────────────────────────────────────────
# CRON_SECRET=
# INTEL_AUTO_HEAL_ON_CRON=false   # default: auto-heal broken cron pulls
# BLOB_READ_WRITE_TOKEN=          # Vercel week snapshots (local disk OK for demo)
# BRANDRADAR_API_KEY=
# ALLOW_DEMO_FIXTURE=false

USE_DISCOVER=true

# ── Discord (see docs/discord.md) ────────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_ID=              # alias for APPLICATION_ID
# DISCORD_PUBLIC_KEY=
# DISCORD_CHANNEL_ID=             # #monday-diff
# DISCORD_HEAL_CHANNEL_ID=        # #heal-alerts
# DISCORD_RULES_CHANNEL_ID=
# DISCORD_START_CHANNEL_ID=
# DISCORD_COMMANDS_CHANNEL_ID=
# DISCORD_SCHEMA_CHANNEL_ID=
# DISCORD_RIVALS_CHANNEL_ID=
# DISCORD_DEMO_CHANNEL_ID=
# DISCORD_SUBMISSION_CHANNEL_ID=
# DISCORD_WEBHOOK_URL=             # optional fallback instead of bot
