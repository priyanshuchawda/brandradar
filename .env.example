# Copy to .env.local. Never commit real keys.

# Bright Data — ask the team when we wire live collectors.
# Signup: https://brdta.com/wemakedevs
# Promo code (billing, lowercase): wemakedevs
BRIGHT_DATA_API_TOKEN=
BRIGHT_DATA_COLLECTOR_ID=

COLLECTOR_ECOMMERCE_DISCOVERY=
COLLECTOR_ECOMMERCE_PDP=
COLLECTOR_EDTECH_DISCOVERY=
COLLECTOR_EDTECH_PDP=
COLLECTOR_FOOD_DISCOVERY=
COLLECTOR_FOOD_PDP=

# Gemini — optional. Plays still work without it (deterministic rules).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Force mock catalog even if tokens exist (until Scraper Studio collectors exist).
USE_MOCK=true

# Find rival homepages via Discover API (cheap: fast mode, 5 results, no page body).
USE_DISCOVER=true
